{
  "name": "Skjematisk plan",
  "short_name": "Skjematisk plan",
  "description": "Tegn, rediger og lagre skjematiske planer fra MS Project. Planene lagres bare i PDF-filene dine.",
  "lang": "nb",
  "id": "/schemplan/",
  "start_url": "/schemplan/",
  "scope": "/schemplan/",
  "display": "standalone",
  "background_color": "#f6f6f4",
  "theme_color": "#1f5fbf",
  "icons": [
    { "src": "icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "icon-512.png", "sizes": "512x512", "type": "image/png" },
    { "src": "icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "file_handlers": [
    {
      "action": "/schemplan/",
      "accept": {
        "application/pdf": [".pdf"],
        "application/json": [".json"]
      }
    }
  ],
  "launch_handler": { "client_mode": "navigate-new" }
}
